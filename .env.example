# ============================================================
# CodeGuard：GitHub PR 问题判定 / 混合检测 / 修复 / 合并
# 复制为 .env 并填入真实值。
# ============================================================

# === GitHub ===
# auto = App 已接入时优先 App，否则用 PAT；pat / app 可强制单一模式
GITHUB_AUTH_MODE=auto
# PAT 兼容路径（CLI / 离线评测 / 未接入 App 时使用）
GITHUB_TOKEN=
# GitHub App 凭据，由控制台「连接 GitHub」自动写入（0600），一般不用手填
GITHUB_APP_STORE=data/github-app.json
# App manifest 与 webhook 依赖的公网 HTTPS 地址（本机请先起内网穿透）
CODEGUARD_PUBLIC_URL=
# 非本机调用 App 管理接口时的管理令牌
CODEGUARD_ADMIN_TOKEN=
# webhook 验签密钥；App 模式由 App 自动生成，PAT 手工 webhook 才需要
GITHUB_WEBHOOK_SECRET=
# GITHUB_API_URL=https://api.github.com
# TARGET_BRANCH=            # 空 = 使用 PR base / 仓库默认分支
MERGE_MODE=auto             # auto | human
MERGE_METHOD=squash         # squash | merge | rebase
PUSH_FIXES=true
CLOSE_ON_NO_ISSUE=false
# 空 = 由仓库策略 mode 决定；internal / external 可强制覆盖
REVIEW_MODE=
# 是否发布 review + inline 评论（false 时退回单条 issue 评论）
POST_REVIEW=true
POST_MERGE_WATCH_HOURS=72

# === LLM（OpenAI 兼容）===
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BUDGET_MAX_CNY=10
REQUEST_TIMEOUT_SEC=120

# === 限制 ===
MAX_PR_FILES=50
MAX_CHANGED_LINES=3000
MAX_DIFF_BYTES=2000000
MAX_FIX_ROUNDS=2
MAX_REVIEW_ROUNDS=2
MAX_JOB_SECONDS=1200
REJECT_CONFIDENCE=0.85

# === 协调器 ===
COORDINATOR_MAX_PARALLEL=6
LLM_MAX_CONCURRENCY=4
SANDBOX_MAX_CONCURRENCY=2
JOB_MAX_ACTIVE=2

# === 沙箱 ===
SANDBOX_BACKEND=docker      # docker | fake（fake 仅测试/离线）
SANDBOX_IMAGE=codeguard-sandbox-python:3.12
SANDBOX_TIMEOUT_SEC=300
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1
SANDBOX_PIDS=256
SANDBOX_ALLOW_PREPARE_NETWORK=false

# === 路径 ===
DATA_DIR=data/jobs
CHECKPOINT_PATH=checkpoints.db
REPORTS_DIR=reports
POLICY_PATH=.codeguard/policy.yml
