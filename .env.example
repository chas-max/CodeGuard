# ============================================================
# 多 Agent 漫剧制作系统 - 环境变量模板
# 复制为 .env 并填入真实值。key 缺失时，对应 provider 的实际调用会报 MissingConfigError。
# ============================================================

# === LLM API Keys ===
# DeepSeek：需求理解 / 导演规划+监督 / 机器审核（deepseek-chat、deepseek-reasoner）
DEEPSEEK_API_KEY=

# DashScope：一个 key 通吃阿里系——创作 qwen-max + 制作 qwen-plus + 通义万相文生图 + CosyVoice TTS
DASHSCOPE_API_KEY=

# MiMo（小米）：可选，导演推理备选（deepseek-reasoner 不可用时降级）
MIMO_API_KEY=

# === TTS（可选，仅当 TTS_PROVIDER=volcano 时需要）===
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=

# === LLM Base URLs（可选，按需覆盖）===
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MIMO_BASE_URL=https://api.mimo.xiaomi.com/v1

# === Provider 选择 ===
T2I_PROVIDER=wanx        # wanx(通义万相,默认) | 后续可扩展 keling/jimeng
TTS_PROVIDER=cosyvoice   # cosyvoice(默认,走 DashScope) | volcano(火山引擎)

# === Tavily 搜索（文本创作参考资料，可选）===
# 有 key 则自动开启；无 key 时创作不受影响（仅跳过搜索步骤）
TAVILY_API_KEY=
# TAVILY_ENABLED=true   # 有 key 时默认 true；可强制关闭

# === 预算与防死循环封顶 ===
BUDGET_MAX_CNY=20.0
# MAX_CLARIFY=5    # 顶层澄清最多 5 轮
# MAX_MACHINE=3    # 机器审核打回最多 3 次
# MAX_HUMAN=3      # 人工审核打回最多 3 次
# MAX_ANCHOR=2     # 锚定图重画最多 2 轮
# MAX_PROD=2       # 制作一致性升级最多 2 次
# MAX_RESOLVE=3    # 导演解决异常最多 3 次

# === 一致性校验（可选视觉依赖，未装自动降级）===
CONSISTENCY_ENABLED=true
CONSISTENCY_FACE_THRESHOLD=0.78
CONSISTENCY_BODY_THRESHOLD=0.70

# === 路径 ===
# FFMPEG_PATH=ffmpeg
# OUTPUT_DIR=data/drama_output
# CHECKPOINT_PATH=checkpoints.db
