# ============================================================
# CodeGuard-Agent - 企业级 Repo 自动化 Bug 修复与单测生成系统
# 复制为 .env 并填入真实值。key 缺失时，对应 provider 的实际调用会报 MissingConfigError。
# ============================================================

# === LLM API Keys ===
# DeepSeek：故障理解 / 规划(deepseek-reasoner) / 异常统筹 / Tech Lead 监督
DEEPSEEK_API_KEY=

# DashScope：一个 key 通吃阿里系——补丁编写 qwen-max + F2P生成/沙箱自愈 qwen-plus
DASHSCOPE_API_KEY=

# MiMo（小米）：可选，规划推理备选（deepseek-reasoner 不可用时降级）
MIMO_API_KEY=

# === LLM Base URLs（可选，按需覆盖）===
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MIMO_BASE_URL=https://api.mimo.xiaomi.com/v1

# === 预算与防死循环封顶 ===
BUDGET_MAX_CNY=20.0
# MAX_CLARIFY=5    # 故障澄清最多 5 轮
# MAX_MACHINE=3    # 静态门控打回最多 3 次
# MAX_HUMAN=3      # 人工审查打回最多 3 次
# MAX_ANCHOR=2     # F2P 锚定重建最多 2 轮
# MAX_PROD=2       # 沙箱自愈轮次最多 2 轮
# MAX_RESOLVE=3    # 异常统筹最多 3 次（硬编码强制检查）

# === 沙箱与门控 ===
SANDBOX_TIMEOUT_SEC=30   # 沙箱内单轮 pytest 强制超时（防死循环）
PER_UNIT_ATTEMPTS=2      # 沙箱 ReAct 每槽位最大自愈重试
TOPK_FILES=3             # AST 故障文件定位 Top-K
COVERAGE_MIN_PCT=0       # 分支覆盖率门槛（0 = 不做覆盖率门控；如 60）
REQUEST_TIMEOUT_SEC=120  # 单次 LLM 请求超时（防单请求无限挂起）

# === 路径 ===
# OUTPUT_DIR=data/codeguard_output
# CHECKPOINT_PATH=checkpoints.db
