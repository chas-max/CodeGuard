      "capabilities": {
        "F1": 1.0,
        "F2": 1.0,
        "F3": 1.0,
        "F4": 0.0,
        "F5": 0.8,
        "F6": 1.0
      },
      "primary_metrics": {
        "F1": "probe_accuracy",
        "F2": "f1",
        "F3": "f1",
        "F5": "validation_pass_rate",
        "F6": "task_success_rate"
